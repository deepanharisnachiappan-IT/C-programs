#include<stdio.h>
int main()
{
int a[2][2]={1,2,3,4};
int b[2][2]={1,2,3,4};
int d[2][2];
printf("A Value\n");
for(int r=0;r<2;r++)
{
    for(int c=0;c<2;c++)
    {
        printf("%d\t",a[r][c]);
    }
    printf("\n");
}

printf("B Value\n");
for(int r=0;r<2;r++)
{
    for(int c=0;c<2;c++)
    {
        printf("%d \t",b[r][c]);
    }
    printf("\n");
}

printf("Multiply  the value\n");

for(int r=0;r<2;r++)
{
    for(int c=0;c<2;c++)
    {
        d[r][c]=a[r][c]*b[r][c];
        printf("%d \t",d[r][c]);
    }
    printf("\n");
}

    return 0;
}
