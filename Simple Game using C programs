#include <stdio.h>

int main()
{
    int user, computer = 2;

    printf("1. Rock\n2. Paper\n3. Scissors\n");
    printf("Enter your choice: ");
    scanf("%d", &user);

    if (user == computer)
        printf("Draw!");
    else if ((user == 1 && computer == 3) ||
             (user == 2 && computer == 1) ||
             (user == 3 && computer == 2))
        printf("You Win!");
    else
        printf("Computer Wins!");

    return 0;
}
