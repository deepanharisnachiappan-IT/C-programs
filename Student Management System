#include <stdio.h>
#include <string.h>

struct Student
{
    int rollno;
    char name[50];
    float marks;
};

int main()
{
    struct Student s[3];
    int i;

    // Input student details
    for(i = 0; i < 3; i++)
    {
        printf("\nEnter details of Student %d\n", i + 1);

        printf("Roll Number: ");
        while(scanf("%d", &s[i].rollno) != 1)
        {
            printf("Invalid Roll Number! Enter again: ");

            while(getchar() != '\n'); // clear input buffer
        }

        while(getchar() != '\n'); // remove newline left by scanf

        printf("Name: ");
        fgets(s[i].name, sizeof(s[i].name), stdin);

        // Remove trailing newline from name
        s[i].name[strcspn(s[i].name, "\n")] = '\0';

        printf("Marks: ");
        while(scanf("%f", &s[i].marks) != 1)
        {
            printf("Invalid Marks! Enter again: ");

            while(getchar() != '\n'); // clear input buffer
        }

        while(getchar() != '\n'); // remove newline
    }

    // Display student details
    printf("\n----- Student Records -----\n");

    for(i = 0; i < 3; i++)
    {
        printf("\nStudent %d\n", i + 1);
        printf("Roll Number : %d\n", s[i].rollno);
        printf("Name        : %s\n", s[i].name);
        printf("Marks       : %.2f\n", s[i].marks);
    }

    return 0;
}
